<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <title>每日工具箱會議紀錄表</title>
  <style>
    @page { size: A4 portrait; margin: 10mm; }
    body {
      font-family: 'Microsoft JhengHei', 'Noto Sans TC', sans-serif;
      margin: 0;
      padding: 0;
      color: #000;
      font-size: 12px;
    }
    .header {
      display: flex;
      align-items: center;
      padding-bottom: 5px;
      margin-bottom: 5px;
    }
    .logo-placeholder {
      width: 50px;
      height: 50px;
      margin-right: 15px;
    }
    .company-info {
      flex: 1;
    }
    .company-name {
      font-size: 24px;
      font-weight: bold;
      margin-bottom: 5px;
    }
    .company-name .en {
      color: #4a8b71;
      font-size: 18px;
      margin-left: 10px;
    }
    .company-details {
      font-size: 12px;
      color: #333;
    }
    .title {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      margin: 10px 0;
      letter-spacing: 5px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }
    td, th {
      border: 1px solid #000;
      padding: 3px;
      text-align: center;
      vertical-align: middle;
      font-size: 11px;
    }
    .left-align { text-align: left; }
    .vertical-text {
      writing-mode: vertical-lr;
      text-orientation: upright;
      letter-spacing: 2px;
    }
    .page-break {
      page-break-before: always;
    }
    .photo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      margin-top: 20px;
    }
    .photo-cell {
      border: 1px solid #ccc;
      padding: 10px;
      text-align: center;
      height: 380px;
      display: flex;
      flex-direction: column;
    }
    .photo-cell img {
      width: 100%;
      height: 330px;
      object-fit: contain;
      margin-bottom: 10px;
    }
    .photo-title {
      font-weight: bold;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <%
    function box(checked) {
      return checked 
        ? '<span style="display:inline-block; border:1px solid #000; width:12px; height:12px; text-align:center; line-height:12px; font-size:10px; font-weight:bold;">V</span>'
        : '<span style="display:inline-block; border:1px solid #000; width:12px; height:12px; text-align:center; line-height:12px;">&nbsp;</span>';
    }
  %>

  <div class="header">
    <% if (logoBase64) { %>
      <img src="<%= logoBase64 %>" class="logo-placeholder" />
    <% } else { %>
      <div class="logo-placeholder">Logo</div>
    <% } %>
    <div class="company-info">
      <div class="company-name">元融科技有限公司<span class="en">YUANRONG TECHNOLOGY</span></div>
      <div class="company-details">
        744 台南市新市區港墘里自由街9號 | 06-5897049 | 統編 24903014
      </div>
    </div>
  </div>

  <div class="title">每日工具箱會議紀錄表</div>

  <table>
  <colgroup>
    <col style="width: 5.5%;">
    <% for(let i=0; i<20; i++) { %>
      <col style="width: 4.725%;">
    <% } %>
  </colgroup>
    <tr>
      <td colspan="2" style="white-space: nowrap; padding: 0 1px;">工程名稱</td>
      <td colspan="7" class="left-align"><%= meeting.project ? meeting.project.name : '' %></td>
      <td colspan="4">會議日期</td>
      <td colspan="8" class="left-align"><%= new Date(meeting.record_date).toLocaleDateString() %></td>
    </tr>
    <tr>
      <td colspan="2" style="white-space: nowrap; padding: 0 1px;">工程地點</td>
      <td colspan="7" class="left-align"></td>
      <td colspan="4">案場負責人</td>
      <td colspan="8" class="left-align"><%= meeting.recorder ? meeting.recorder.name : '' %></td>
    </tr>
    <tr>
      <td colspan="2" style="white-space: nowrap; padding: 0 1px;">施工區域</td>
      <td colspan="19" class="left-align">
        <% 
          const areas = ['浪板屋頂', '建物屋頂', '地面', '圳溝', '蓄水池'];
          let otherArea = '';
          if (meeting.work_area && !areas.includes(meeting.work_area)) {
            otherArea = meeting.work_area;
          }
        %>
        <% areas.forEach(a => { %>
          <%- box(meeting.work_area === a) %> <%= a %> &nbsp;&nbsp;
        <% }) %>
        <%- box(!!otherArea) %> 其他: <span style="border-bottom: 1px solid #000; padding: 0 20px;"><%= otherArea || '' %></span>
      </td>
    </tr>

    <!-- 工作內容 -->
    <tr>
      <td colspan="21" style="font-weight: bold;">工作內容:(重要工作項目打勾)</td>
    </tr>
    
    <!-- 20 rows of 安全宣導內容 span -->
    <tr>
      <td rowspan="20" class="vertical-text" style="font-weight: bold; font-size: 14px;">安全宣導內容(現場監工確實填寫)</td>
      <td colspan="5" style="font-weight: bold;">工作項目</td>
      <td colspan="5" style="font-weight: bold;">備註</td>
      <td colspan="5" style="font-weight: bold;">工作項目</td>
      <td colspan="5" style="font-weight: bold;">備註</td>
    </tr>

    <% 
      const wItems1 = ['測量、收方', '灌漿作業', '鋼筋綁紮', '板模作業', '鋼構作業', '吊掛作業'];
      const wItems2 = ['浪板鋪設更換作業', '太陽能板鋪設作業', '機電設備作業', '機電配管線作業', '材料堆疊、環境整理', '其他(於備註欄說明)'];
      for (let i = 0; i < 6; i++) {
        const i1 = wItems1[i];
        const i2 = wItems2[i];
        
        let c1 = false, n1 = '';
        if (meeting.work_items) {
          const found = meeting.work_items.find(w => w.name === i1);
          if (found) { c1 = true; n1 = found.note || ''; }
        }

        let c2 = false, n2 = '';
        if (meeting.work_items) {
          const found = meeting.work_items.find(w => w.name === i2);
          if (found) { c2 = true; n2 = found.note || ''; }
        }
    %>
    <tr>
      <td colspan="5" class="left-align"><%- box(c1) %> <%= i1 %></td>
      <td colspan="5" class="left-align"><%= n1 %></td>
      <td colspan="5" class="left-align"><%- box(c2) %> <%= i2 %></td>
      <td colspan="5" class="left-align"><%= n2 %></td>
    </tr>
    <% } %>

    <!-- Hazards -->
    <tr>
      <td colspan="11" style="font-weight: bold;">物理性危害</td>
      <td colspan="3" style="font-weight: bold;">化學性危害</td>
      <td colspan="3" style="font-weight: bold;">火災危害</td>
      <td colspan="3" style="font-weight: bold;">感電危害</td>
    </tr>
    <tr>
      <td colspan="11" class="left-align" style="vertical-align: top; line-height: 1.2; font-size: 11px;">
        <div>
          <span style="margin-right: 8px; white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('跌落、墜落')) %> 跌落、墜落</span>
          <span style="margin-right: 8px; white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('物體飛落')) %> 物體飛落</span>
          <span style="margin-right: 8px; white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('異物入眼')) %> 異物入眼</span>
          <span style="white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('高、低溫接觸')) %> 高、低溫接觸</span>
        </div>
        <div>
          <span style="margin-right: 8px; white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('擦傷、刺傷、扭傷、壓傷、夾傷、割傷、碰撞')) %> 擦傷、刺傷、扭傷、壓傷、夾傷、割傷、碰撞</span>
          <span style="white-space: nowrap;"><%- box(meeting.hazards && meeting.hazards.includes('噪音')) %> 噪音</span>
        </div>
      </td>
      <td colspan="3" class="left-align" style="vertical-align: top; line-height: 1.2;">
        <%- box(meeting.hazards && meeting.hazards.includes('化學性灼傷')) %> 化學性灼傷<br>
        <%- box(meeting.hazards && meeting.hazards.includes('化學吸入')) %> 化學吸入
      </td>
      <td colspan="3" class="left-align" style="vertical-align: top; line-height: 1.2;">
        <%- box(meeting.hazards && meeting.hazards.includes('火災')) %> 火災<br>
        <%- box(meeting.hazards && meeting.hazards.includes('爆炸')) %> 爆炸
      </td>
      <td colspan="3" class="left-align" style="vertical-align: top; line-height: 1.2;">
        <%- box(meeting.hazards && meeting.hazards.includes('感電')) %> 感電
      </td>
    </tr>

    <!-- Safety Measures -->
    <tr>
      <td colspan="20" style="font-weight: bold;">現場安全衛生措施</td>
    </tr>
    <tr>
      <td colspan="5" style="font-weight: bold;">個人防護具</td>
      <td colspan="3" style="font-weight: bold;">個人防護具</td>
      <td colspan="4" style="font-weight: bold;">安全防護設施</td>
      <td colspan="4" style="font-weight: bold;">安全防護設施</td>
      <td colspan="4" style="font-weight: bold;">安全防護設施</td>
    </tr>
    <% 
      const ppe1 = ['安全帽', '安全鞋', '施工背心', '全身背負式安全帶', '防墜器', '安全眼鏡', '絕緣手套', '安全面罩'];
      const ppe2 = ['防護衣', '防塵口罩', '防毒面具', '防化圍裙', '防化手套', '防化鞋', '', ''];
      const fac1 = ['合梯', '爬梯', '施工架', '安全母索', '安全防墜網', '吊籠/護欄', '警示圍籬', '防火毯'];
      const fac2 = ['搶救設備', '滅火器', '通風設備', '檢電器', '高壓電防護設備', '接地棒', '漏電斷路器', '電焊防電擊裝置'];
      const fac3 = ['照明設備', '通訊設備', '氧乙炔焊防回火裝置', '', '', '', '', ''];
      
      for(let i=0; i<8; i++) {
        const check = (val) => val ? `${box(meeting.safety_measures && meeting.safety_measures.includes(val))} ${val}` : '';
    %>
    <tr>
      <td colspan="5" class="left-align"><%- check(ppe1[i]) %></td>
      <td colspan="3" class="left-align"><%- check(ppe2[i]) %></td>
      <td colspan="4" class="left-align"><%- check(fac1[i]) %></td>
      <td colspan="4" class="left-align"><%- check(fac2[i]) %></td>
      <td colspan="4" class="left-align"><%- check(fac3[i]) %></td>
    </tr>
    <% } %>

    <!-- 其他存在風險說明 -->
    <tr>
      <td colspan="20" class="left-align">
        <span style="font-weight: bold;">其他存在風險說明:</span> <%= meeting.other_risks || '' %>
      </td>
    </tr>

    <!-- Signatures -->
    <tr>
      <td rowspan="6" class="vertical-text" style="font-weight: bold; font-size: 14px;">現場施工人員簽名</td>
      <td colspan="20" class="left-align">施工人數: <%= meeting.worker_count %> 人</td>
    </tr>
    <% for(let r=0; r<5; r++) { %>
      <tr>
        <% 
          const colSpans = [5, 5, 5, 5]; 
          for(let c=0; c<4; c++) { 
            const num = r * 4 + c + 1; // 1 to 20
            // But wait, the docx has them in columns: 1..5, 6..10, 11..15, 16..20!
            // Let's adjust num based on row and col
            // r=0..4, c=0..3
            const displayNum = c * 5 + r + 1;
            const sigImg = (meeting.signatures && meeting.signatures[displayNum - 1]) ? meeting.signatures[displayNum - 1] : null;
        %>
          <td colspan="<%= colSpans[c] %>" style="height: 45px; text-align: left; vertical-align: top; padding: 2px;">
            <div style="font-size: 10px;"><%= displayNum %>.</div>
            <% if (sigImg) { %>
              <div style="text-align: center; margin-top: -10px;">
                <img src="<%= sigImg %>" style="max-height: 32px; max-width: 90%; object-fit: contain;" />
              </div>
            <% } %>
          </td>
        <% } %>
      </tr>
    <% } %>

    <!-- Equipment (Empty) -->
    <tr>
      <td colspan="21" style="font-weight: bold;">現場使用機具</td>
    </tr>
    <tr>
      <td colspan="2" style="font-weight: bold;">機具名稱</td>
      <td colspan="1" style="font-weight: bold;">單位</td>
      <td colspan="3" style="font-weight: bold;">數量(H/台)</td>
      <td colspan="2" style="font-weight: bold;">機具名稱</td>
      <td colspan="2" style="font-weight: bold;">單位</td>
      <td colspan="3" style="font-weight: bold;">數量(H/台)</td>
      <td colspan="4" style="font-weight: bold;">機具名稱</td>
      <td colspan="2" style="font-weight: bold;">單位</td>
      <td colspan="2" style="font-weight: bold;">數量(H/台)</td>
    </tr>
    <% for(let i=0; i<3; i++) { %>
    <tr style="height: 25px;">
      <td colspan="2"></td><td colspan="1"></td><td colspan="3"></td>
      <td colspan="2"></td><td colspan="2"></td><td colspan="3"></td>
      <td colspan="4"></td><td colspan="2"></td><td colspan="2"></td>
    </tr>
    <% } %>
  </table>

  <!-- PAGE 2+: 照片 -->
  <% if (allPhotos && allPhotos.length > 0) { 
      let totalPages = Math.ceil(allPhotos.length / 6);
      for(let p=0; p<totalPages; p++) {
        let chunk = allPhotos.slice(p*6, (p+1)*6);
  %>
    <div class="page-break"></div>
    <div class="header">
      <% if (logoBase64) { %>
        <img src="<%= logoBase64 %>" class="logo-placeholder" />
      <% } else { %>
        <div class="logo-placeholder">Logo</div>
      <% } %>
      <div class="company-info">
        <div class="company-name">元融科技有限公司<span class="en">YUANRONG TECHNOLOGY</span></div>
        <div class="company-details">
          每日工具箱會議照片紀錄
        </div>
      </div>
    </div>
    
    <div class="photo-grid">
      <% chunk.forEach((photo, idx) => { %>
        <div class="photo-cell">
          <img src="<%= photo %>" alt="Photo">
          <div class="photo-title">會議照片 <%= (p*6) + idx + 1 %></div>
        </div>
      <% }) %>
    </div>
  <% 
      }
    } 
  %>

</body>
</html>
